{
  "name": "qa-engineer-playwright-typescript-assignment",
  "version": "1.0.0",
  "description": "Playwright + TypeScript QA assignment: UI tests for Sauce Demo and API tests for Restful-Booker",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox",
    "test:ui:chromium": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium firefox"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
